# Copy to .env to set compose defaults.
AGORA_BIND=127.0.0.1
AGORA_PORT=8787
AGORA_WEB=false
# Host names clients use to reach the server; required beyond localhost.
AGORA_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# none, or token (see the README's Tokens and roles).
AGORA_AUTH=none
# The URL browsers use, e.g. https://agora.example; https marks cookies Secure.
AGORA_PUBLIC_URL=
# Proxies whose X-Forwarded-For names the client, e.g. 172.16.0.0/12.
AGORA_TRUSTED_PROXIES=
# true offers agents a feedback tool (see the README's Agent feedback).
AGORA_FEEDBACK=false
