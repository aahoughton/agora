# Antigravity CLI (agy)
# skills: @/skills

## client config, server waits up to 50s
# add to @/mcp_config.json at mcpServers.smoot:
{
  "url": "http://127.0.0.1:8787/mcp?namespace=default"
}

## client config, server waits up to 4m0s
# add to @/mcp_config.json at mcpServers.smoot:
{
  "url": "http://127.0.0.1:8787/mcp?namespace=default",
  "timeoutSeconds": 250
}

## client config with a token, server waits up to 4m0s
# add to @/mcp_config.json at mcpServers.smoot:
{
  "command": "smoot",
  "args": ["mcp", "--url", "http://127.0.0.1:8787", "--namespace", "default"],
  "timeoutSeconds": 250
}
# Set SMOOT_TOKEN in the environment Antigravity runs in; the stdio bridge reads it. Keep smoot on the client's PATH.

## stop hook
# add to @/hooks.json at smoot:
{"Stop": [{"type": "command", "command": "smoot hook stop --client antigravity"}]}
# Keeps a session in its expected smoot conversations. Does nothing unless SMOOT_AGENT is set in the client's environment; set SMOOT_TOKEN there too for a server with tokens.
