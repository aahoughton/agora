## .codex/config.toml
[mcp_servers.smoot]
url = "http://127.0.0.1:8790/mcp?namespace=team"
bearer_token_env_var = "SMOOT_TOKEN"
default_tools_approval_mode = "approve"
tool_timeout_sec = 250

## .codex/hooks.json
{"hooks": {"Stop": [{"hooks": [{
	"command":       "smoot hook stop --url http://127.0.0.1:8790 --namespace team",
	"statusMessage": "smoot: checking conversations",
	"type":          "command"
}]}]}}
