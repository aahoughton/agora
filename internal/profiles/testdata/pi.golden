# Pi coding agent (pi)
# skills: ~/.agents/skills

## client config, server waits up to 50s
# add to @/mcp.json at mcpServers.smoot:
{
  "exposure": "direct",
  "url": "http://127.0.0.1:8787/mcp?namespace=default"
}

## client config, server waits up to 4m0s
# add to @/mcp.json at mcpServers.smoot:
{
  "exposure": "direct",
  "url": "http://127.0.0.1:8787/mcp?namespace=default"
}

## client config with a token, server waits up to 4m0s
# add to @/mcp.json at mcpServers.smoot:
{
  "exposure": "direct",
  "url": "http://127.0.0.1:8787/mcp?namespace=default",
  "headers": {"Authorization": "Bearer ${SMOOT_TOKEN}"}
}
# Set SMOOT_TOKEN in the environment Pi runs in; it expands the header reference when connecting.
