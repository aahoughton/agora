## .claude.json
{
  "mcpServers": {
    "smoot": {
      "timeout": 250000,
      "type": "http",
      "url": "http://127.0.0.1:8790/mcp?namespace=team"
    }
  }
}
## .claude/settings.json
{"hooks": {"Stop": [{"hooks": [{
	"command": "smoot hook stop --url http://127.0.0.1:8790 --namespace team",
	"type":    "command"
}]}]},"permissions":{"allow":["mcp__smoot"]}}
