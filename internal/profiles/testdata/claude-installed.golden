## .claude.json
{
  "mcpServers": {
    "agora": {
      "timeout": 250000,
      "type": "http",
      "url": "http://127.0.0.1:8790/mcp?namespace=team"
    }
  }
}
## .claude/settings.json
{"hooks": {"Stop": [{"hooks": [{
	"command": "agora hook stop --url http://127.0.0.1:8790 --namespace team",
	"type":    "command"
}]}]},"permissions":{"allow":["mcp__agora"]}}
